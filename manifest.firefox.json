{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "Save PNG/JPG",
  "version": "1.0.0",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "homepage_url": "https://enhancephoto.org/image-upscaler",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "permissions": [
    "contextMenus",
    "downloads",
    "storage"
  ],
  "host_permissions": [
    "https://enhancephoto.org/*",
    "http://*/*",
    "https://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://enhancephoto.org/*"
      ],
      "js": [
        "enhancephoto-bridge.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "save-image-png-jpg@enhancephoto.org",
      "strict_min_version": "121.0",
      "data_collection_permissions": {
        "required": [
          "websiteContent"
        ]
      }
    }
  }
}
